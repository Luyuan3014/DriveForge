{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driveforge.local/schemas/hardware_manifest.schema.json",
  "title": "DriveForge Hardware Manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "project", "request", "status", "facts", "blockers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {"type": "string"},
    "request": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "BLOCKED"]},
    "facts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/fact"}
    },
    "fact_summary": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["value", "confidence", "source", "evidence"],
      "properties": {
        "value": {},
        "confidence": {"enum": ["VERIFIED", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "source": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "excerpt": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
